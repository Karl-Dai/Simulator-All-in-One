diff --git a/go/cmd/slavegui/persistence_suite.go b/go/cmd/slavegui/persistence_suite.go
new file mode 100644
index 0000000..5906af5
--- /dev/null
+++ b/go/cmd/slavegui/persistence_suite.go
@@ -0,0 +1,122 @@
+//go:build simlab_suite
+
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/Karl-Dai/ModbusSim/go/internal/configstore"
+	"github.com/Karl-Dai/ModbusSim/go/internal/project"
+	"github.com/Karl-Dai/ModbusSim/go/internal/suitehost"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+const projectFileExtension = ".saioproj"
+const storageRole = "modbus.slave"
+
+func (a *App) openPersistence() {
+	if a.config.store != nil {
+		_ = a.config.store.Close()
+		a.config.store = nil
+	}
+	dir, err := suitehost.DataDir("slave")
+	if err != nil {
+		a.config.err = err
+		return
+	}
+	store, err := configstore.Open(filepath.Dir(dir), storageRole)
+	if err != nil {
+		a.config.err = err
+		return
+	}
+	a.config.store = store
+	var saved project.Project
+	present, err := store.Load("workspace", &saved)
+	if err == nil && present {
+		_, err = a.manager.ApplyProject(&saved)
+	}
+	a.config.err = err
+}
+func (a *App) initializePersistence() {
+	a.config.mu.Lock()
+	defer a.config.mu.Unlock()
+	a.openPersistence()
+}
+func (a *App) LoadPreferences(legacy map[string]any) (map[string]any, error) {
+	a.config.mu.Lock()
+	defer a.config.mu.Unlock()
+	if a.config.err != nil || a.config.store == nil {
+		a.openPersistence()
+	}
+	if a.config.err != nil {
+		return nil, a.config.err
+	}
+	data, err := json.Marshal(legacy)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = a.config.store.MigrateJSON("ui", data, "webview-localStorage-v1"); err != nil {
+		a.config.err = err
+		return nil, err
+	}
+	var values map[string]any
+	if _, err = a.config.store.Load("ui", &values); err != nil {
+		a.config.err = err
+		return nil, err
+	}
+	if values == nil {
+		values = map[string]any{}
+	}
+	return values, nil
+}
+func (a *App) SavePreferences(values map[string]any) error {
+	a.config.mu.Lock()
+	defer a.config.mu.Unlock()
+	if a.config.err != nil {
+		return a.config.err
+	}
+	if a.config.store == nil {
+		return fmt.Errorf("configuration is not initialized")
+	}
+	return a.config.store.Save("ui", values)
+}
+func (a *App) readProject(path string) (int, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return 0, err
+	}
+	header := make([]byte, 16)
+	_, readErr := io.ReadFull(file, header)
+	_ = file.Close()
+	if readErr != nil && readErr != io.ErrUnexpectedEOF && readErr != io.EOF {
+		return 0, readErr
+	}
+	var saved *project.Project
+	if string(header) == "SQLite format 3\x00" {
+		saved = &project.Project{}
+		err = configstore.ReadProject(path, storageRole, "workspace", saved)
+	} else {
+		saved, err = project.LoadFile(path)
+	}
+	if err != nil {
+		return 0, err
+	}
+	return changeValue(a, nil, func() (int, error) { return a.manager.ApplyProject(saved) })
+}
+func (a *App) writeProject(path string) error {
+	a.config.mu.Lock()
+	defer a.config.mu.Unlock()
+	if a.config.err != nil {
+		return a.config.err
+	}
+	if filepath.Ext(path) != ".saioproj" {
+		return fmt.Errorf("export requires a .saioproj file; legacy imports are kept unchanged")
+	}
+	saved, err := a.snapshot()
+	if err != nil {
+		return err
+	}
+	return configstore.ExportProject(path, storageRole, "workspace", saved)
+}
diff --git a/go/cmd/slavegui/persistence_suite_test.go b/go/cmd/slavegui/persistence_suite_test.go
new file mode 100644
index 0000000..29ea163
--- /dev/null
+++ b/go/cmd/slavegui/persistence_suite_test.go
@@ -0,0 +1,95 @@
+//go:build simlab_suite
+
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/Karl-Dai/ModbusSim/go/internal/appstate"
+	"github.com/Karl-Dai/ModbusSim/go/internal/configstore"
+	"github.com/Karl-Dai/ModbusSim/go/internal/project"
+	"path/filepath"
+	"testing"
+)
+
+func persistedApp(t *testing.T) *App {
+	t.Helper()
+	a := newApp()
+	a.initializePersistence()
+	if a.config.err != nil {
+		t.Fatal(a.config.err)
+	}
+	t.Cleanup(func() { a.shutdown(context.Background()) })
+	return a
+}
+func TestSuiteSlaveRestartAndLegacyImport(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("SIMLAB_DATA_DIR", root)
+	first := persistedApp(t)
+	info, err := first.CreateConnection(appstate.CreateConnectionRequest{Transport: project.Transport{Type: project.TransportTCP, Host: "127.0.0.1", Port: 15020}, SlaveID: 1, RegisterRanges: []appstate.RegisterRange{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = first.AddDevice(appstate.AddDeviceRequest{ConnectionID: info.ID, SlaveID: 2, Name: "saved"}); err != nil {
+		t.Fatal(err)
+	}
+	restarted := persistedApp(t)
+	rows := restarted.ListConnections()
+	if len(rows) != 1 || rows[0].State != appstate.Stopped {
+		t.Fatalf("restart: %+v", rows)
+	}
+	devices, err := restarted.ListDevices(info.ID)
+	if err != nil || len(devices) != 2 {
+		t.Fatalf("devices: %+v %v", devices, err)
+	}
+	legacy := filepath.Join(root, "old.modbusproj")
+	if err = project.SaveFile(legacy, first.manager.Project()); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = first.LoadProject(legacy); err != nil {
+		t.Fatal(err)
+	}
+	export := filepath.Join(root, "slave.saioproj")
+	if err = first.SaveProject(export); err != nil {
+		t.Fatal(err)
+	}
+	var saved project.Project
+	// The master role cannot import the slave role's SQLite document.
+	if err = configstore.ReadProject(export, "modbus.master", "workspace", &saved); err == nil {
+		t.Fatal("cross-role project accepted")
+	}
+}
+
+func TestSuiteLegacyV1AndInvalidImportPreserveWorkspace(t *testing.T) {
+	t.Setenv("SIMLAB_DATA_DIR", t.TempDir())
+	a := persistedApp(t)
+	legacy := filepath.Join("..", "..", "internal", "project", "testdata", "v1-slave-legacy-blocks.json")
+	if _, err := a.LoadProject(legacy); err != nil {
+		t.Fatal(err)
+	}
+	before := a.manager.Project()
+	if len(before.Connections) == 0 || len(before.Connections[0].Devices) == 0 {
+		t.Fatal("fixture did not restore devices")
+	}
+	original, err := json.Marshal(before)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before.Connections[0].Devices = append(before.Connections[0].Devices, before.Connections[0].Devices[0])
+	invalid := filepath.Join(t.TempDir(), "duplicate.modbusproj")
+	if err = project.SaveFile(invalid, before); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = a.LoadProject(invalid); err == nil {
+		t.Fatal("duplicate slave id accepted")
+	}
+	current, _ := json.Marshal(a.manager.Project())
+	if string(current) != string(original) {
+		t.Fatal("failed import replaced live workspace")
+	}
+	restarted := persistedApp(t)
+	saved, _ := json.Marshal(restarted.manager.Project())
+	if string(saved) != string(original) {
+		t.Fatal("failed import changed durable workspace")
+	}
+}
