diff --git a/go/internal/appstate/register_ranges.go b/go/internal/appstate/register_ranges.go
new file mode 100644
index 0000000..ce30227
--- /dev/null
+++ b/go/internal/appstate/register_ranges.go
@@ -0,0 +1,111 @@
+package appstate
+
+import (
+	"fmt"
+	"math/rand"
+	"sort"
+
+	"github.com/Karl-Dai/ModbusSim/go/internal/register"
+	"github.com/Karl-Dai/ModbusSim/go/internal/slave"
+)
+
+// RegisterRange describes inclusive raw addresses, not the number of typed points.
+// int fields ensure invalid IPC input is rejected before narrowing to uint16.
+type RegisterRange struct {
+	RegisterType string
+	StartAddress int
+	EndAddress   int
+	DataType     string
+	Endian       string
+}
+
+func rangeDefinitions(ranges []RegisterRange) ([]register.RegisterDef, error) {
+	ordered := append([]RegisterRange{}, ranges...)
+	sort.Slice(ordered, func(i, j int) bool {
+		if ordered[i].RegisterType != ordered[j].RegisterType {
+			return ordered[i].RegisterType < ordered[j].RegisterType
+		}
+		return ordered[i].StartAddress < ordered[j].StartAddress
+	})
+	// Validate intervals before expanding: even repeated full-area ranges cannot
+	// allocate an unbounded definition set.
+	for i, r := range ordered {
+		if r.StartAddress < 0 || r.EndAddress > 65535 || r.EndAddress < r.StartAddress {
+			return nil, fmt.Errorf("range %s: addresses must satisfy 0 <= start <= end <= 65535", r.RegisterType)
+		}
+		def, err := registerDef(AddRegisterRequest{RegisterType: r.RegisterType, DataType: r.DataType, Endian: r.Endian})
+		if err != nil {
+			return nil, err
+		}
+		bitArea := def.RegisterType == register.Coil || def.RegisterType == register.DiscreteInput
+		if (bitArea && def.DataType != register.TypeBool) || (!bitArea && def.DataType == register.TypeBool) {
+			return nil, fmt.Errorf("range %s: use bool for bit areas and a numeric type for register areas", r.RegisterType)
+		}
+		width := int(def.DataType.RegisterCount())
+		if (r.EndAddress-r.StartAddress+1)%width != 0 {
+			return nil, fmt.Errorf("range %s@%d..%d cannot contain complete %s points", r.RegisterType, r.StartAddress, r.EndAddress, r.DataType)
+		}
+		if i > 0 && ordered[i-1].RegisterType == r.RegisterType && ordered[i-1].EndAddress >= r.StartAddress {
+			return nil, fmt.Errorf("range %s@%d overlaps another range", r.RegisterType, r.StartAddress)
+		}
+	}
+	defs := make([]register.RegisterDef, 0)
+	for _, r := range ordered {
+		def, _ := registerDef(AddRegisterRequest{RegisterType: r.RegisterType, DataType: r.DataType, Endian: r.Endian})
+		for address := r.StartAddress; address <= r.EndAddress; address += int(def.DataType.RegisterCount()) {
+			def.Address = uint16(address)
+			defs = append(defs, def)
+		}
+	}
+	return defs, nil
+}
+
+func createDevice(id uint8, name, initMode string, ranges []RegisterRange, legacyConnection bool) (*slave.Device, error) {
+	// Preserve older IPC clients. Both current dialogs always send an explicit
+	// array, including [] for an empty device. Project loading uses saved points.
+	if ranges == nil {
+		if initMode == "random" {
+			return slave.WithRandomRegisters(id, name, defaultMaxAddress), nil
+		}
+		if legacyConnection || initMode == "zero" {
+			return slave.WithDefaultRegisters(id, name, defaultMaxAddress), nil
+		}
+		return slave.NewDevice(id, name), nil
+	}
+	if initMode != "" && initMode != "zero" && initMode != "random" {
+		return nil, fmt.Errorf("unknown initialization mode %q", initMode)
+	}
+	defs, err := rangeDefinitions(ranges)
+	if err != nil {
+		return nil, err
+	}
+	d := slave.NewDevice(id, name)
+	d.RegisterDefs = defs
+	for _, def := range defs {
+		d.RegisterMap.EnsureFromDef(def)
+		if initMode != "random" {
+			continue
+		}
+		value := float64(rand.Intn(65536))
+		switch def.DataType {
+		case register.TypeBool:
+			value = float64(rand.Intn(2))
+		case register.TypeInt16:
+			value -= 32768
+		case register.TypeUInt32:
+			value = float64(rand.Uint32())
+		case register.TypeInt32:
+			value = float64(int32(rand.Uint32()))
+		case register.TypeFloat:
+			value = rand.Float64()*2000 - 1000
+		}
+		words, err := register.EncodeValue(value, def.DataType, def.Endian)
+		if err != nil {
+			return nil, err
+		}
+		for offset, word := range words {
+			writeRaw(d.RegisterMap, def.RegisterType, def.Address+uint16(offset), word)
+		}
+	}
+	return d, nil
+}
diff --git a/go/internal/appstate/register_ranges_test.go b/go/internal/appstate/register_ranges_test.go
new file mode 100644
index 0000000..a23df8b
--- /dev/null
+++ b/go/internal/appstate/register_ranges_test.go
@@ -0,0 +1,160 @@
+package appstate
+
+import (
+	"bytes"
+	"fmt"
+	"github.com/Karl-Dai/ModbusSim/go/internal/mbap"
+	"github.com/Karl-Dai/ModbusSim/go/internal/register"
+	"math"
+	"net"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestExplicitRegisterRangesWireAndProject(t *testing.T) {
+	m := NewManager(Events{})
+	defer m.CloseAll()
+	port := freePort(t)
+	ranges := []RegisterRange{
+		{"coil", 0, 15, "bool", "big"},
+		{"discrete_input", 0, 1, "bool", "big"},
+		{"holding_register", 0, 9, "uint16", "big"},
+		{"holding_register", 100, 119, "float32", "little"},
+		{"input_register", 65534, 65535, "uint32", "mid_big"},
+	}
+	info, err := m.CreateConnection(CreateConnectionRequest{Transport: tcpTransport(port), SlaveID: 1, RegisterRanges: ranges})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defs, err := m.ListRegisters(info.ID, 1, "")
+	if err != nil || len(defs) != 39 {
+		t.Fatalf("definitions: %d %v", len(defs), err)
+	}
+	if err = m.StartConnection(info.ID); err != nil {
+		t.Fatal(err)
+	}
+	peer, err := net.DialTimeout("tcp", fmt.Sprintf("127.0.0.1:%d", port), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	_ = peer.SetDeadline(time.Now().Add(5 * time.Second))
+	exchange := func(request, want []byte) {
+		t.Helper()
+		if err := mbap.WriteFrame(peer, 1, 1, request); err != nil {
+			t.Fatal(err)
+		}
+		_, got, err := mbap.ReadFrame(peer)
+		if err != nil || !bytes.Equal(got, want) {
+			t.Fatalf("request %x: got %x want %x (%v)", request, got, want, err)
+		}
+	}
+	exchange([]byte{6, 0, 0, 0, 42}, []byte{6, 0, 0, 0, 42})
+	exchange([]byte{3, 0, 0, 0, 1}, []byte{3, 2, 0, 42})
+	exchange([]byte{16, 0, 1, 0, 2, 4, 0, 7, 0, 8}, []byte{16, 0, 1, 0, 2})
+	exchange([]byte{3, 0, 0, 0, 3}, []byte{3, 6, 0, 42, 0, 7, 0, 8})
+	exchange([]byte{5, 0, 0, 255, 0}, []byte{5, 0, 0, 255, 0})
+	exchange([]byte{1, 0, 0, 0, 1}, []byte{1, 1, 1})
+	exchange([]byte{15, 0, 1, 0, 2, 1, 3}, []byte{15, 0, 1, 0, 2})
+	exchange([]byte{1, 0, 0, 0, 3}, []byte{1, 1, 7})
+	exchange([]byte{2, 0, 0, 0, 1}, []byte{2, 1, 0})
+	exchange([]byte{4, 255, 254, 0, 2}, []byte{4, 4, 0, 0, 0, 0})
+	exchange([]byte{3, 0, 9, 0, 2}, []byte{0x83, 2})   // crosses a hole
+	exchange([]byte{6, 0, 10, 0, 42}, []byte{0x86, 2}) // not configured
+	exchange([]byte{4, 0, 0, 0, 1}, []byte{0x84, 2})   // same address, different area
+	path := filepath.Join(t.TempDir(), "ranges.modbusproj")
+	if err := m.SaveProject(path); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.LoadProject(path); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := m.ListRegisters(info.ID, 1, "")
+	if err != nil || len(loaded) != 39 {
+		t.Fatalf("loaded: %d %v", len(loaded), err)
+	}
+	value, err := m.ReadRegister(info.ID, 1, "holding_register", 0)
+	if err != nil || value.Value != 42 {
+		t.Fatalf("saved value: %+v %v", value, err)
+	}
+	empty, err := m.AddDevice(AddDeviceRequest{ConnectionID: info.ID, SlaveID: 2, InitMode: "zero", RegisterRanges: []RegisterRange{}})
+	if err != nil || empty.RegisterCount != 0 {
+		t.Fatalf("empty device: %+v %v", empty, err)
+	}
+	newEmpty, err := m.CreateConnection(CreateConnectionRequest{Transport: tcpTransport(freePort(t)), SlaveID: 1, InitMode: "random", RegisterRanges: []RegisterRange{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	emptyDefs, err := m.ListRegisters(newEmpty.ID, 1, "")
+	if err != nil || len(emptyDefs) != 0 {
+		t.Fatalf("empty connection: %d %v", len(emptyDefs), err)
+	}
+}
+
+func TestRegisterRangeValidationIsAtomic(t *testing.T) {
+	cases := map[string][]RegisterRange{
+		"negative":     {{"coil", -1, 2, "bool", "big"}},
+		"overflow":     {{"holding_register", 65534, 65536, "uint16", "big"}},
+		"reversed":     {{"holding_register", 2, 1, "uint16", "big"}},
+		"incomplete":   {{"holding_register", 0, 2, "float32", "big"}},
+		"overlap":      {{"holding_register", 0, 1, "uint32", "big"}, {"holding_register", 1, 2, "uint16", "big"}},
+		"bit type":     {{"coil", 0, 1, "uint16", "big"}},
+		"word type":    {{"input_register", 0, 1, "bool", "big"}},
+		"unknown area": {{"other", 0, 1, "uint16", "big"}},
+		"endian":       {{"input_register", 0, 1, "uint16", "bad"}},
+	}
+	for name, ranges := range cases {
+		t.Run(name, func(t *testing.T) {
+			m := NewManager(Events{})
+			defer m.CloseAll()
+			if _, err := m.CreateConnection(CreateConnectionRequest{Transport: tcpTransport(5020), SlaveID: 1, RegisterRanges: ranges}); err == nil {
+				t.Fatal("accepted invalid range")
+			}
+			if len(m.ListConnections()) != 0 {
+				t.Fatal("failed creation left a connection")
+			}
+			conn, err := m.CreateConnection(CreateConnectionRequest{Transport: tcpTransport(5020), SlaveID: 1, RegisterRanges: []RegisterRange{}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = m.AddDevice(AddDeviceRequest{ConnectionID: conn.ID, SlaveID: 2, RegisterRanges: ranges}); err == nil {
+				t.Fatal("accepted invalid device")
+			}
+			devices, err := m.ListDevices(conn.ID)
+			if err != nil || len(devices) != 1 {
+				t.Fatalf("failed add changed devices: %+v %v", devices, err)
+			}
+		})
+	}
+}
+
+func TestRandomTypedRangesAndMaximumAddress(t *testing.T) {
+	ranges := []RegisterRange{{"coil", 65535, 65535, "bool", "big"}}
+	for i, typ := range []string{"uint16", "int16", "uint32", "int32", "float32"} {
+		ranges = append(ranges, RegisterRange{"holding_register", i * 20, i*20 + 19, typ, "mid_little"})
+	}
+	d, err := createDevice(1, "random", "random", ranges, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	anyNonZero := false
+	for _, def := range d.RegisterDefs {
+		if def.RegisterType != register.HoldingRegType {
+			continue
+		}
+		words := d.RegisterMap.ReadHoldingRegisters(def.Address, def.DataType.RegisterCount())
+		value, err := register.DecodeValue(words, def.DataType, def.Endian)
+		if err != nil || math.IsNaN(value) || math.IsInf(value, 0) {
+			t.Fatalf("invalid random value: %v %v", value, err)
+		}
+		anyNonZero = anyNonZero || value != 0
+	}
+	if !anyNonZero {
+		t.Fatal("random points are all zero")
+	}
+	defs, err := rangeDefinitions([]RegisterRange{{"holding_register", 0, 65535, "uint16", "big"}})
+	if err != nil || len(defs) != 65536 {
+		t.Fatalf("full area: %d %v", len(defs), err)
+	}
+}
diff --git a/go/internal/suitehost/appearance.go b/go/internal/suitehost/appearance.go
new file mode 100644
index 0000000..c9e1148
--- /dev/null
+++ b/go/internal/suitehost/appearance.go
@@ -0,0 +1,89 @@
+package suitehost
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// Appearance exposes read-only display preferences to the suite webview.
+type Appearance struct{ suiteMode bool }
+
+// Both build modes expose stable bindings, but only a suite build may read its settings.
+func NewAppearance(suiteMode bool) *Appearance { return &Appearance{suiteMode: suiteMode} }
+
+// AppearanceV1 deliberately excludes private launcher and protocol state.
+type AppearanceV1 struct {
+	SchemaVersion int    `json:"schemaVersion"`
+	Theme         string `json:"theme"`
+	Language      string `json:"language"`
+}
+
+func (a *Appearance) ReadAppearance() (AppearanceV1, error) {
+	result := AppearanceV1{SchemaVersion: 1, Theme: "system", Language: "en"}
+	if !a.suiteMode {
+		return result, fmt.Errorf("appearance is managed by the standalone application")
+	}
+	root := os.Getenv("SIMLAB_DATA_DIR")
+	if !filepath.IsAbs(root) {
+		return result, fmt.Errorf("SIMLAB_DATA_DIR must be absolute")
+	}
+	data, err := os.ReadFile(filepath.Join(root, "launcher.json"))
+	if os.IsNotExist(err) {
+		return result, nil
+	}
+	if err != nil {
+		return result, err
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return result, err
+	}
+	if fields == nil {
+		return result, fmt.Errorf("launcher preferences must be an object")
+	}
+	if raw, exists := fields["schemaVersion"]; exists {
+		var version int
+		if err := json.Unmarshal(raw, &version); err != nil || version != 1 {
+			return result, fmt.Errorf("unsupported launcher preferences version")
+		}
+	}
+	var theme, language string
+	_ = json.Unmarshal(fields["theme"], &theme)
+	_ = json.Unmarshal(fields["language"], &language)
+	if theme == "light" || theme == "dark" {
+		result.Theme = theme
+	}
+	if language == "auto" || language == "zh-CN" {
+		result.Language = language
+	}
+	return result, nil
+}
+
+func (a *Appearance) Theme() (string, error) {
+	if !a.suiteMode {
+		return "", fmt.Errorf("appearance is managed by the standalone application")
+	}
+	root := os.Getenv("SIMLAB_DATA_DIR")
+	if !filepath.IsAbs(root) {
+		return "", fmt.Errorf("SIMLAB_DATA_DIR must be absolute")
+	}
+	data, err := os.ReadFile(filepath.Join(root, "launcher.json"))
+	if os.IsNotExist(err) {
+		return "system", nil
+	}
+	if err != nil {
+		return "", err
+	}
+	var value struct {
+		Theme string `json:"theme"`
+	}
+	if err := json.Unmarshal(data, &value); err != nil {
+		return "", err
+	}
+	if value.Theme == "light" || value.Theme == "dark" {
+		return value.Theme, nil
+	}
+	return "system", nil
+}
diff --git a/go/internal/suitehost/config.go b/go/internal/suitehost/config.go
new file mode 100644
index 0000000..d5dd0f7
--- /dev/null
+++ b/go/internal/suitehost/config.go
@@ -0,0 +1,79 @@
+// Package suitehost isolates the embedded SimLab build from standalone apps.
+package suitehost
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+
+	"github.com/wailsapp/wails/v2/pkg/options"
+	"github.com/wailsapp/wails/v2/pkg/options/linux"
+	"github.com/wailsapp/wails/v2/pkg/options/windows"
+)
+
+// DataDir never resolves against the launcher's working directory. A relative
+// override is rejected instead of silently creating data beside a payload.
+func DataDir(role string) (string, error) {
+	if role != "master" && role != "slave" {
+		return "", fmt.Errorf("unsupported Modbus suite role %q", role)
+	}
+	root := os.Getenv("SIMLAB_DATA_DIR")
+	if root == "" {
+		config, err := os.UserConfigDir()
+		if err != nil {
+			return "", fmt.Errorf("resolve SimLab data directory: %w", err)
+		}
+		root = filepath.Join(config, "SimLab")
+	}
+	if !filepath.IsAbs(root) {
+		return "", fmt.Errorf("SIMLAB_DATA_DIR must be an absolute path")
+	}
+	return filepath.Join(root, "modbus."+role), nil
+}
+
+// Configure is called only by the simlab_suite build-tagged entry point.
+func Configure(app *options.App, role string) error {
+	dir, err := DataDir(role)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return fmt.Errorf("create Modbus suite data directory: %w", err)
+	}
+	identity := "cloud.carldai.simlab.modbus." + role
+	if role == "master" {
+		app.Title = "ModbusMaster — SimLab"
+	} else {
+		app.Title = "ModbusSlave — SimLab"
+	}
+	switch runtime.GOOS {
+	case "windows":
+		if app.Windows == nil {
+			app.Windows = &windows.Options{}
+		}
+		app.Windows.WebviewUserDataPath = filepath.Join(dir, "webview")
+	case "linux":
+		// WebKitGTK's default context follows GLib's XDG locations. Set these
+		// before Wails initializes GTK/WebKit and keep the two roles separate.
+		for name, leaf := range map[string]string{
+			"XDG_DATA_HOME": "data", "XDG_CONFIG_HOME": "config", "XDG_CACHE_HOME": "cache",
+		} {
+			path := filepath.Join(dir, leaf)
+			if err := os.MkdirAll(path, 0700); err != nil {
+				return fmt.Errorf("create %s: %w", name, err)
+			}
+			if err := os.Setenv(name, path); err != nil {
+				return fmt.Errorf("set %s: %w", name, err)
+			}
+		}
+		if app.Linux == nil {
+			// Preserve Wails' default GPU policy when setting ProgramName.
+			app.Linux = &linux.Options{WebviewGpuPolicy: linux.WebviewGpuPolicyNever}
+		}
+		app.Linux.ProgramName = identity
+	}
+	// WKWebView on macOS uses the suite-specific CFBundleIdentifier written
+	// by suite.sh, rather than the standalone app's website-data namespace.
+	return nil
+}
diff --git a/go/internal/suitehost/config_test.go b/go/internal/suitehost/config_test.go
new file mode 100644
