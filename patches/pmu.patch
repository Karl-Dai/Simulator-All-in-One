+  --shadow: #00000022;
+}
+@media (prefers-color-scheme: dark) {
+  :root[data-simlab]:not([data-theme="light"]):not([data-theme="dark"]):not([data-simlab-theme="light"]) {
+    color-scheme: dark;
+    --workspace: #181818;
