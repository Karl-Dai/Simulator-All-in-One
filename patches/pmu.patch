+    --topbar: #242424;
+    --surface: #242424;
+    --role-surface: #242424;
+    --text: #ededed;
+    --secondary: #b5b5b5;
+    --muted: #a3a3a3;
+    --line: #3b3b3b;
+    --brand: #90b0ff;
+    --on-brand: #181818;
+    --copper: #b5b5b5;
