+  --warning: #edc884;
+  --on-accent: #181818;
+  --accent-hover: #b4c9ff;
+  --danger-surface: #3b2529;
+  --hover: #303030;
+  --selected: #28354d;
+  --green: #92d4a5;
+  --green-line: #385744;
