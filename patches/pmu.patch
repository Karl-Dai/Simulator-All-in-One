+.error-notice__actions button {
+  padding: 4px 10px;
+  min-height: 30px;
+  border: 1px solid var(--c-surface1, #b9c1cc);
+  border-radius: var(--radius-md, 6px);
+  background: var(--surface, #ffffff);
