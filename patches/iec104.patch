+}
+:root[data-simlab] {
+  --iec: var(--secondary); --iec-surface: var(--hover);
+  --modbus: var(--secondary); --modbus-surface: var(--hover);
+  --pmu: var(--secondary); --pmu-surface: var(--hover);
+  --opcua: var(--secondary); --opcua-surface: var(--hover);
+}
+
+/* Compatibility aliases keep the protocol components on one semantic palette. */
+:root[data-simlab], :root[data-simlab][data-simlab-theme] {
+  --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px;
+  --space-5: 20px; --space-6: 24px; --space-8: 32px;
+  --radius-sm: 4px; --radius-md: 6px; --radius-lg: 10px;
+  --text-xs: 12px; --text-sm: 12px; --text-md: 13px; --text-lg: 15px;
+  --duration-fast: 120ms; --duration-normal: 180ms;
+  --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
+  --font-sans: var(--font-ui);
+  --c-crust: var(--workspace); --c-mantle: var(--sidebar); --c-base: var(--surface);
+  --c-surface0: var(--line); --c-surface1: color-mix(in srgb, var(--text) 28%, var(--surface));
+  --c-surface2: color-mix(in srgb, var(--text) 42%, var(--surface));
+  --c-overlay0: var(--muted); --c-overlay1: var(--muted); --c-subtext0: var(--muted); --c-subtext1: var(--secondary);
+  --c-text: var(--text); --c-blue: var(--brand); --c-lavender: var(--accent-hover);
+  --c-sapphire: var(--iec); --c-sky: var(--iec); --c-teal: var(--pmu);
+  --c-green: var(--green); --c-yellow: var(--warning); --c-peach: var(--copper);
+  --c-red: var(--danger); --c-mauve: var(--opcua);
+  --c-on-accent: var(--on-accent); --c-accent-hover: var(--accent-hover);
+  --c-control-bg: var(--surface); --c-hover-bg: var(--hover);
+  --c-selection-bg: var(--selected); --c-selection-text: var(--text);
+  --c-row-border: var(--line); --c-row-danger-bg: var(--danger-surface);
+  --c-success-bg: var(--green-surface); --c-success-text: var(--green);
+  --c-neutral-bg: var(--hover); --c-neutral-text: var(--secondary);
+  --bg-app: var(--workspace); --bg-panel: var(--sidebar); --bg-raised: var(--surface);
+  --bg-hover: var(--hover); --bg-active: var(--selected); --bg-inset: var(--workspace);
+  --border-subtle: var(--line); --border-strong: var(--c-surface1);
+  --text-primary: var(--text); --text-secondary: var(--secondary);
+  --text-muted: var(--muted); --text-disabled: var(--muted);
+  --accent: var(--brand); --success: var(--green); --info: var(--iec);
+  --shadow-sm: 0 1px 3px var(--shadow); --shadow-md: 0 4px 16px var(--shadow);
+  --shadow-lg: 0 16px 48px #0003;
