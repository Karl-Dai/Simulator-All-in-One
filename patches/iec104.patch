diff --git a/crates/shared/simlab_preferences.rs b/crates/shared/simlab_preferences.rs
new file mode 100644
index 0000000..795c0c1
--- /dev/null
+++ b/crates/shared/simlab_preferences.rs
@@ -0,0 +1,104 @@
+#[derive(Debug, serde::Serialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct AppearanceV1 {
+    schema_version: u32,
+    theme: String,
+    language: String,
+}
+
+fn read_appearance(root: &std::path::Path) -> Result<AppearanceV1, String> {
+    if !root.is_absolute() {
+        return Err("SIMLAB_DATA_DIR must be absolute".into());
+    }
+    let mut result = AppearanceV1 {
+        schema_version: 1,
+        theme: "system".into(),
+        language: "en".into(),
+    };
+    let data = match std::fs::read(root.join("launcher.json")) {
+        Ok(data) => data,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(result),
+        Err(error) => return Err(error.to_string()),
+    };
+    let value: serde_json::Value = serde_json::from_slice(&data).map_err(|e| e.to_string())?;
+    if !value.is_object()
+        || value.get("schemaVersion").is_some_and(|v| v.as_u64() != Some(1))
+    {
+        return Err("unsupported launcher preferences version".into());
+    }
+    if let Some(theme @ ("light" | "dark")) = value["theme"].as_str() {
+        result.theme = theme.into();
+    }
+    if let Some(language @ ("auto" | "zh-CN")) = value["language"].as_str() {
+        result.language = language.into();
+    }
+    Ok(result)
+}
+
+#[tauri::command]
+pub(crate) fn simlab_appearance() -> Result<AppearanceV1, String> {
+    if !cfg!(feature = "simlab-suite") {
+        return Err("Appearance is managed by the standalone application".into());
+    }
+    let root = std::env::var_os("SIMLAB_DATA_DIR")
+        .map(std::path::PathBuf::from)
+        .ok_or("SIMLAB_DATA_DIR is not configured")?;
+    read_appearance(&root)
+}
+
+/// Legacy theme behavior remains unchanged for components not yet migrated.
+#[tauri::command]
+pub(crate) fn simlab_theme() -> Result<String, String> {
+    if !cfg!(feature = "simlab-suite") {
+        return Err("Appearance is managed by the standalone application".into());
+    }
+    let root = std::env::var_os("SIMLAB_DATA_DIR")
+        .map(std::path::PathBuf::from)
+        .ok_or("SIMLAB_DATA_DIR is not configured")?;
+    if !root.is_absolute() {
+        return Err("SIMLAB_DATA_DIR must be absolute".into());
+    }
+    let data = match std::fs::read(root.join("launcher.json")) {
+        Ok(data) => data,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok("system".into()),
+        Err(error) => return Err(error.to_string()),
+    };
+    let value: serde_json::Value = serde_json::from_slice(&data).map_err(|e| e.to_string())?;
+    match value["theme"].as_str() {
+        Some("light") => Ok("light".into()),
+        Some("dark") => Ok("dark".into()),
+        _ => Ok("system".into()),
+    }
+}
+
+#[cfg(test)]
+mod appearance_tests {
+    use super::*;
+
+    #[test]
+    fn shared_file_contract_and_read_only_behavior() {
+        let cases: serde_json::Value = serde_json::from_str(include_str!("contracts/appearance-cases.json")).unwrap();
+        let unique = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        let root = std::env::temp_dir().join(format!("saio-appearance-{}-{unique}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let path = root.join("launcher.json");
+        for case in cases["fileCases"].as_array().unwrap() {
+            if let Some(contents) = case["contents"].as_str() {
+                std::fs::write(&path, contents).unwrap();
+            } else if path.exists() {
+                std::fs::remove_file(&path).unwrap();
+            }
+            let got = read_appearance(&root);
+            if case.get("error").is_some() {
+                assert!(got.is_err(), "{}", case["name"]);
+            } else {
+                assert_eq!(serde_json::to_value(got.unwrap()).unwrap(), case["appearance"], "{}", case["name"]);
+            }
+            if let Some(contents) = case["contents"].as_str() {
+                assert_eq!(std::fs::read_to_string(&path).unwrap(), contents);
+            }
+        }
+        std::fs::remove_dir_all(root).unwrap();
+        assert!(read_appearance(std::path::Path::new("relative")).is_err());
+    }
+}
diff --git a/crates/shared/suite.rs b/crates/shared/suite.rs
new file mode 100644
index 0000000..a85e1fc
--- /dev/null
+++ b/crates/shared/suite.rs
@@ -0,0 +1,94 @@
+use std::path::PathBuf;
+use tauri::AppHandle;
+#[cfg(feature = "simlab-suite")]
+use tauri::Manager;
+
+#[cfg(feature = "simlab-suite")]
+struct SuiteDataRoot(PathBuf);
+
+/// Suite stores use an absolute path; standalone stores retain their old path.
+pub(crate) fn store_path(app: &AppHandle, filename: &str) -> PathBuf {
+    #[cfg(feature = "simlab-suite")]
+    {
+        return app.state::<SuiteDataRoot>().0.join(filename);
+    }
+    #[cfg(not(feature = "simlab-suite"))]
+    {
+        let _ = app;
+        PathBuf::from(filename)
+    }
+}
+
+pub(crate) fn ensure_component_updates_allowed() -> Result<(), String> {
+    if cfg!(feature = "simlab-suite") {
+        Err("套件内组件由 SimLab 整包更新，请从套件入口获取新版。".into())
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(feature = "simlab-suite")]
+fn role_data_root(base: PathBuf, role: &str) -> Result<PathBuf, String> {
+    if !base.is_absolute() {
+        return Err("SIMLAB_DATA_DIR 必须是绝对路径。".into());
+    }
+    Ok(base.join(role))
+}
+
+#[cfg(feature = "simlab-suite")]
+pub(crate) fn initialize(
+    app: &mut tauri::App,
+    role: &str,
+    expected_identifier: &str,
+) -> Result<(), Box<dyn std::error::Error>> {
+    if app.config().identifier != expected_identifier {
+        return Err("套件构建缺少 tauri.suite.conf.json 配置。".into());
+    }
+    let base = match std::env::var_os("SIMLAB_DATA_DIR") {
+        Some(value) => PathBuf::from(value),
+        None => app.path().config_dir()?.join("SimLab"),
+    };
+    let root = role_data_root(base, role)?;
+    std::fs::create_dir_all(&root)?;
+    let webview_root = root.join("webview");
+    std::fs::create_dir_all(&webview_root)?;
+    app.manage(SuiteDataRoot(root));
+
+    // The suite overlay delays initial window creation until its storage path
+    // is available. Windows/Linux honor this directory. WKWebView storage on
+    // macOS is isolated by the suite-only bundle identifier instead.
+    let window = app
+        .config()
+        .app
+        .windows
+        .first()
+        .ok_or("套件缺少主窗口配置。")?;
+    tauri::WebviewWindowBuilder::from_config(app.handle(), window)?
+        .data_directory(webview_root)
+        .build()?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn updates_belong_to_the_selected_distribution() {
+        assert_eq!(
+            ensure_component_updates_allowed().is_err(),
+            cfg!(feature = "simlab-suite")
+        );
+    }
+
+    #[cfg(feature = "simlab-suite")]
+    #[test]
+    fn role_storage_is_absolute_and_separated() {
+        let base = std::env::temp_dir().join("SimLab 中文 space");
+        let master = role_data_root(base.clone(), "iec104-master").unwrap();
+        let slave = role_data_root(base.clone(), "iec104-slave").unwrap();
+        assert_eq!(master, base.join("iec104-master"));
+        assert_ne!(master, slave);
+        assert!(role_data_root(PathBuf::from("relative"), "iec104-master").is_err());
+    }
+}
