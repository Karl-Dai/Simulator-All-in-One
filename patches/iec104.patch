diff --git a/master-frontend/src/simlab-ui/contracts/appearance.ts b/master-frontend/src/simlab-ui/contracts/appearance.ts
new file mode 100644
index 0000000..bea1803
--- /dev/null
+++ b/master-frontend/src/simlab-ui/contracts/appearance.ts
@@ -0,0 +1,50 @@
+export type Theme = 'system' | 'light' | 'dark'
+export type Language = 'auto' | 'zh-CN' | 'en'
+export type ResolvedLocale = Exclude<Language, 'auto'>
+
+export interface AppearanceV1 {
+  schemaVersion: 1
+  theme: Theme
+  language: Language
+}
+
+export interface AppearanceReader {
+  readAppearance(): Promise<AppearanceV1>
+}
+
+export const DEFAULT_APPEARANCE: Readonly<AppearanceV1> = Object.freeze({
+  schemaVersion: 1,
+  theme: 'system',
+  language: 'en',
+})
+
+export class AppearanceContractError extends Error {
+  readonly code: 'invalid_response' | 'unsupported_version'
+
+  constructor(code: 'invalid_response' | 'unsupported_version') {
+    super(code === 'unsupported_version'
+      ? 'Unsupported appearance interface version; repair the complete suite.'
+      : 'The appearance adapter returned an invalid response.')
+    this.name = 'AppearanceContractError'
+    this.code = code
+  }
+}
+
+/** Validate the native response without returning unrelated settings. */
+export function parseAppearance(value: unknown): AppearanceV1 {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new AppearanceContractError('invalid_response')
+  }
+  const input = value as Record<string, unknown>
+  if (input.schemaVersion !== 1) throw new AppearanceContractError('unsupported_version')
+  return {
+    schemaVersion: 1,
+    theme: input.theme === 'light' || input.theme === 'dark' ? input.theme : 'system',
+    language: input.language === 'auto' || input.language === 'zh-CN' ? input.language : 'en',
+  }
+}
+
+export function resolveLanguage(language: Language, systemLanguage: string): ResolvedLocale {
+  if (language !== 'auto') return language
+  return systemLanguage.toLowerCase().startsWith('zh') ? 'zh-CN' : 'en'
+}
diff --git a/master-frontend/src/simlab-ui/modal.ts b/master-frontend/src/simlab-ui/modal.ts
new file mode 100644
index 0000000..94a816e
--- /dev/null
+++ b/master-frontend/src/simlab-ui/modal.ts
@@ -0,0 +1,61 @@
+import type { ObjectDirective } from 'vue'
+
+const stack: HTMLElement[] = []
+const callbacks = new WeakMap<HTMLElement, () => void>()
+const cleanups = new WeakMap<HTMLElement, () => void>()
+
+/** Focus and Escape lifecycle for existing teleported dialogs. */
+export const vModal: ObjectDirective<HTMLElement, () => void> = {
+  mounted(el, binding) {
+    const previous = document.activeElement as HTMLElement | null
+    callbacks.set(el, binding.value)
+    stack.push(el)
+    const dialog = el.querySelector<HTMLElement>('[role="dialog"], [role="alertdialog"]') ?? el
+    dialog.setAttribute('role', dialog.getAttribute('role') ?? 'dialog')
+    dialog.setAttribute('aria-modal', 'true')
+    if (!dialog.hasAttribute('aria-label') && !dialog.hasAttribute('aria-labelledby')) {
+      const title = el.querySelector<HTMLElement>('.modal-title, .dialog-title, .about-title, h2, h3')?.textContent
+      if (title) dialog.setAttribute('aria-label', title.trim())
+    }
+    el.tabIndex = -1
+    const focusables = () => Array.from(el.querySelectorAll<HTMLElement>(
+      'button:not(:disabled), input:not(:disabled):not([type="hidden"]), select:not(:disabled), textarea:not(:disabled), a[href], summary, [tabindex]',
+    )).filter(node => node.tabIndex >= 0 && node.getClientRects().length > 0 && !node.closest('[inert], [hidden]'))
+    const focusFirst = () => (focusables()[0] ?? el).focus()
+    const keydown = (event: KeyboardEvent) => {
+      if (stack[stack.length - 1] !== el || (event.isComposing || event.keyCode === 229)) return
+      if (event.key === 'Escape') {
+        event.preventDefault()
+        event.stopImmediatePropagation()
+        callbacks.get(el)?.()
+        return
+      }
+      if (event.key !== 'Tab') return
+      const nodes = focusables()
+      const first = nodes[0], last = nodes[nodes.length - 1]
+      if (!first) { event.preventDefault(); el.focus(); return }
+      if (event.shiftKey && (document.activeElement === first || document.activeElement === el || !el.contains(document.activeElement))) {
+        event.preventDefault(); last?.focus()
+      } else if (!event.shiftKey && (document.activeElement === last || document.activeElement === el || !el.contains(document.activeElement))) {
+        event.preventDefault(); first.focus()
+      }
+    }
+    document.addEventListener('keydown', keydown, true)
+    queueMicrotask(() => {
+      if (el.isConnected && stack[stack.length - 1] === el && !el.contains(document.activeElement)) focusFirst()
+    })
+    cleanups.set(el, () => {
+      document.removeEventListener('keydown', keydown, true)
+      const wasTop = stack[stack.length - 1] === el
+      const index = stack.indexOf(el)
+      if (index >= 0) stack.splice(index, 1)
+      if (wasTop && previous?.isConnected && (!stack.length || stack[stack.length - 1]?.contains(previous))) previous.focus()
+    })
+  },
+  updated(el, binding) { callbacks.set(el, binding.value) },
+  unmounted(el) {
+    cleanups.get(el)?.()
+    cleanups.delete(el)
+    callbacks.delete(el)
+  },
+}
diff --git a/master-frontend/src/simlab-ui/theme.ts b/master-frontend/src/simlab-ui/theme.ts
new file mode 100644
index 0000000..edd380b
--- /dev/null
+++ b/master-frontend/src/simlab-ui/theme.ts
@@ -0,0 +1,66 @@
+/** Shared by all eight suite webviews. No protocol or project data crosses IPC. */
+type Theme = 'light' | 'dark' | 'system'
+type NativeWindow = Window & {
+  go?: { suitehost?: { Appearance?: { Theme(): Promise<string> } } }
+  __TAURI_INTERNALS__?: { invoke<T>(command: string): Promise<T> }
+}
+
+export function startSuiteTheme() {
+  const root = document.documentElement
+  const native = window as NativeWindow
+  const media = window.matchMedia('(prefers-color-scheme: dark)')
+  let theme: Theme = 'system'
+  let stopped = false
+  let pending = false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let warned = false
+  root.dataset.simlab = 'component'
+
+  function apply() {
+    const resolved = theme === 'system' ? (media.matches ? 'dark' : 'light') : theme
+    // A separate attribute prevents a standalone theme composable from
+    // accidentally overriding the suite palette when the OS changes.
+    root.dataset.simlabTheme = resolved
+    root.dataset.theme = resolved
+    root.style.colorScheme = resolved
+  }
+
+  async function refresh() {
+    clearTimeout(timer)
+    if (stopped || pending || document.hidden) return
+    pending = true
+    try {
+      const value = native.go?.suitehost?.Appearance
+        ? await native.go.suitehost.Appearance.Theme()
+        : await native.__TAURI_INTERNALS__?.invoke<string>('simlab_theme')
+      if (value !== 'system' && value !== 'light' && value !== 'dark') {
+        throw new Error('Invalid SimLab theme response')
+      }
+      if (!stopped) { theme = value; apply() }
+      warned = false
+    } catch (error) {
+      if (!warned) console.warn('Cannot synchronize SimLab appearance; keeping current theme', error)
+      warned = true
+    } finally {
+      pending = false
+      if (!stopped && !document.hidden) timer = setTimeout(refresh, 1500)
+    }
+  }
+  function visibility() {
+    clearTimeout(timer)
+    if (!document.hidden) void refresh()
+  }
+  function stop() {
+    stopped = true
+    clearTimeout(timer)
+    media.removeEventListener('change', apply)
+    document.removeEventListener('visibilitychange', visibility)
+    window.removeEventListener('pagehide', stop)
+  }
+  apply()
+  void refresh()
+  media.addEventListener('change', apply)
+  document.addEventListener('visibilitychange', visibility)
+  window.addEventListener('pagehide', stop)
+  return stop
+}
