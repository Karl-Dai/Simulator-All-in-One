+  padding: 16px; margin-bottom: 0; gap: 12px;
+}
+:root[data-simlab][data-simlab-theme] .layout :is(h3, h4) { font-size: 13px; font-weight: 600; margin: 0 0 8px; }
+:root[data-simlab][data-simlab-theme] .layout label { font-size: 13px; align-items: center; flex-wrap: wrap; }
+:root[data-simlab][data-simlab-theme] .layout :is(input, select) { min-width: 0; max-width: 100%; }
+:root[data-simlab][data-simlab-theme] .layout button {
+  background: var(--surface); color: var(--text); border: 1px solid var(--c-surface1); min-height: 32px; padding: 5px 10px;
+}
+:root[data-simlab][data-simlab-theme] .layout button:hover:not(:disabled) { background: var(--hover); }
+:root[data-simlab][data-simlab-theme] .layout table { border-collapse: collapse; }
+:root[data-simlab][data-simlab-theme] .layout :is(th, td) { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: left; }
+:root[data-simlab][data-simlab-theme] .layout th { background: var(--sidebar); }
+:root[data-simlab][data-simlab-theme] .layout :is(.preset-load, .preset-save, .phasor-row) { display: flex; flex-wrap: wrap; gap: 8px; }
+:root[data-simlab][data-simlab-theme] .layout .phasor-row input { width: 88px; }
+:root[data-simlab][data-simlab-theme] .layout hr { border: 0; border-top: 1px solid var(--line); margin: 8px 0; }
+:root[data-simlab][data-simlab-theme] .layout .error { color: var(--danger); }
+@media (max-width: 760px) {
+  :root[data-simlab][data-simlab-theme] .app > .layout { grid-template-columns: minmax(0, 1fr); overflow: auto; }
+  :root[data-simlab][data-simlab-theme] .layout > :is(.left, .right) { overflow: visible; }
+}
+@media (prefers-reduced-motion: reduce) {
+  :root[data-simlab][data-simlab-theme] *, :root[data-simlab][data-simlab-theme] *::before, :root[data-simlab][data-simlab-theme] *::after {
+    animation: none !important; transition: none !important; scroll-behavior: auto !important;
+  }
+}
diff --git a/master-frontend/src/simlab-ui/theme.ts b/master-frontend/src/simlab-ui/theme.ts
new file mode 100644
index 0000000..edd380b
--- /dev/null
+++ b/master-frontend/src/simlab-ui/theme.ts
@@ -0,0 +1,66 @@
+/** Shared by all eight suite webviews. No protocol or project data crosses IPC. */
+type Theme = 'light' | 'dark' | 'system'
+type NativeWindow = Window & {
+  go?: { suitehost?: { Appearance?: { Theme(): Promise<string> } } }
+  __TAURI_INTERNALS__?: { invoke<T>(command: string): Promise<T> }
+}
+
+export function startSuiteTheme() {
+  const root = document.documentElement
+  const native = window as NativeWindow
+  const media = window.matchMedia('(prefers-color-scheme: dark)')
+  let theme: Theme = 'system'
+  let stopped = false
+  let pending = false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let warned = false
+  root.dataset.simlab = 'component'
+
+  function apply() {
+    const resolved = theme === 'system' ? (media.matches ? 'dark' : 'light') : theme
+    // A separate attribute prevents a standalone theme composable from
+    // accidentally overriding the suite palette when the OS changes.
+    root.dataset.simlabTheme = resolved
+    root.dataset.theme = resolved
+    root.style.colorScheme = resolved
+  }
+
+  async function refresh() {
+    clearTimeout(timer)
+    if (stopped || pending || document.hidden) return
+    pending = true
+    try {
+      const value = native.go?.suitehost?.Appearance
+        ? await native.go.suitehost.Appearance.Theme()
+        : await native.__TAURI_INTERNALS__?.invoke<string>('simlab_theme')
+      if (value !== 'system' && value !== 'light' && value !== 'dark') {
+        throw new Error('Invalid SimLab theme response')
+      }
+      if (!stopped) { theme = value; apply() }
+      warned = false
+    } catch (error) {
+      if (!warned) console.warn('Cannot synchronize SimLab appearance; keeping current theme', error)
+      warned = true
+    } finally {
+      pending = false
+      if (!stopped && !document.hidden) timer = setTimeout(refresh, 1500)
+    }
+  }
+  function visibility() {
+    clearTimeout(timer)
+    if (!document.hidden) void refresh()
+  }
+  function stop() {
+    stopped = true
+    clearTimeout(timer)
+    media.removeEventListener('change', apply)
+    document.removeEventListener('visibilitychange', visibility)
+    window.removeEventListener('pagehide', stop)
+  }
+  apply()
+  void refresh()
+  media.addEventListener('change', apply)
+  document.addEventListener('visibilitychange', visibility)
+  window.addEventListener('pagehide', stop)
+  return stop
+}
