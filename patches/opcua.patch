new file mode 100644
index 0000000..35f30af
--- /dev/null
+++ b/crates/opcuasim-core/src/suite.rs
@@ -0,0 +1,71 @@
+//! Writable paths for the bundled SimLab applications. Never use the install tree.
+use std::path::{Component, Path, PathBuf};
+
+fn resolve(root: Option<PathBuf>, config: Option<PathBuf>, role: &str) -> std::io::Result<PathBuf> {
+    let root = root
+        .or_else(|| config.map(|p| p.join("SimLab")))
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                "No user configuration directory",
+            )
+        })?;
+    let mut components = Path::new(role).components();
+    if !root.is_absolute()
+        || !matches!(components.next(), Some(Component::Normal(_)))
+        || components.next().is_some()
+    {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "Invalid SimLab data path",
+        ));
+    }
+    Ok(root.join(role))
+}
+
+pub fn role_dir(role: &str) -> std::io::Result<PathBuf> {
+    let dir = resolve(
+        std::env::var_os("SIMLAB_DATA_DIR").map(PathBuf::from),
+        dirs::config_dir(),
+        role,
+    )?;
+    std::fs::create_dir_all(&dir)?;
+    Ok(dir)
+}
+
+pub fn master_pki_dir() -> std::io::Result<PathBuf> {
+    Ok(role_dir("opcua-master")?.join("pki"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn configured_root_and_roles_are_isolated() {
+        let root = std::env::temp_dir().join("simlab-path-test");
+        let master = resolve(Some(root.clone()), None, "opcua-master").unwrap();
+        let server = resolve(Some(root.clone()), None, "opcua-server").unwrap();
+        assert_eq!(master, root.join("opcua-master"));
+        assert_ne!(master, server);
+        assert!(master.is_absolute());
+        assert!(resolve(Some(root.clone()), None, "..").is_err());
+        assert!(resolve(Some(root), None, "master/other").is_err());
+    }
+
+    #[test]
+    fn fallback_never_uses_the_working_directory() {
+        let config = std::env::temp_dir().join("user-config");
+        assert_eq!(
+            resolve(None, Some(config.clone()), "opcua-master").unwrap(),
+            config.join("SimLab/opcua-master")
+        );
+        assert!(resolve(
+            Some(PathBuf::from("relative")),
+            Some(config),
+            "opcua-master"
+        )
+        .is_err());
+        assert!(resolve(None, None, "opcua-master").is_err());
+    }
+}
diff --git a/crates/shared/config_close.rs b/crates/shared/config_close.rs
new file mode 100644
index 0000000..bdf3c9b
--- /dev/null
+++ b/crates/shared/config_close.rs
@@ -0,0 +1,138 @@
+//! Native close waits for the suite frontend to finish its registered writes.
+use std::sync::atomic::{AtomicBool, Ordering};
+use tauri::{AppHandle, Emitter, Manager, RunEvent, Runtime, State, WindowEvent};
+
+/// The frontend arms the guard only after its event listener is installed.
+/// A failed initial page can therefore still be closed normally.
+#[derive(Default)]
+pub struct CloseGuard {
+    armed: AtomicBool,
+    requested: AtomicBool,
+    approved: AtomicBool,
+}
+#[derive(Debug, PartialEq, Eq)]
+enum CloseDecision {
+    Allow,
+    Prevent { notify: bool },
+}
+impl CloseGuard {
+    fn enable(&self) {
+        self.armed.store(true, Ordering::Release);
+    }
+    fn request(&self) -> CloseDecision {
+        if !self.armed.load(Ordering::Acquire) || self.approved.load(Ordering::Acquire) {
+            return CloseDecision::Allow;
+        }
+        let notify = !self.requested.swap(true, Ordering::AcqRel);
+        CloseDecision::Prevent { notify }
+    }
+    fn confirm(&self) -> Result<(), String> {
+        if !self.armed.load(Ordering::Acquire)
+            || !self.requested.load(Ordering::Acquire)
+            || self
+                .approved
+                .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+                .is_err()
+        {
+            return Err("No configuration close request is pending".into());
+        }
+        self.requested.store(false, Ordering::Release);
+        Ok(())
+    }
+}
+
+#[tauri::command]
+pub async fn simlab_enable_configuration_close(guard: State<'_, CloseGuard>) -> Result<(), String> {
+    guard.enable();
+    Ok(())
+}
+
+#[tauri::command]
+pub async fn simlab_confirm_configuration_close(
+    app: AppHandle,
+    guard: State<'_, CloseGuard>,
+) -> Result<(), String> {
+    guard.confirm()?;
+    // exit(0) emits ExitRequested too; approval lets that event proceed.
+    app.exit(0);
+    Ok(())
+}
+
+fn request_flush<R: Runtime>(app: &AppHandle<R>) {
+    if let Err(error) = app.emit("saio-before-close", ()) {
+        // Permit another native close request to retry a failed delivery.
+        app.state::<CloseGuard>()
+            .requested
+            .store(false, Ordering::Release);
+        log::error!("configuration flush request could not reach the frontend: {error}");
+    }
+}
+
+pub fn protect<R: Runtime>(builder: tauri::Builder<R>) -> tauri::Builder<R> {
+    builder
+        .manage(CloseGuard::default())
+        .on_window_event(|window, event| {
+            if let WindowEvent::CloseRequested { api, .. } = event {
+                if let CloseDecision::Prevent { notify } = window.state::<CloseGuard>().request() {
+                    api.prevent_close();
+                    if notify {
+                        request_flush(window.app_handle());
+                    }
+                }
+            }
+        })
+}
+
+pub fn on_run_event<R: Runtime>(app: &AppHandle<R>, event: RunEvent) {
+    if let RunEvent::ExitRequested { api, .. } = event {
+        if let CloseDecision::Prevent { notify } = app.state::<CloseGuard>().request() {
+            api.prevent_exit();
+            if notify {
+                request_flush(app);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn initial_page_without_listener_can_close_or_exit() {
+        let guard = CloseGuard::default();
+        assert_eq!(guard.request(), CloseDecision::Allow);
+        assert!(guard.confirm().is_err());
+    }
+
+    #[test]
+    fn confirmation_without_an_active_request_cannot_exit() {
+        let guard = CloseGuard::default();
+        guard.enable();
+        assert!(guard.confirm().is_err());
+        assert!(!guard.approved.load(Ordering::Acquire));
+    }
+
+    #[test]
+    fn armed_window_and_exit_requests_coalesce_until_confirmation() {
+        let guard = CloseGuard::default();
+        guard.enable();
+        assert_eq!(guard.request(), CloseDecision::Prevent { notify: true });
+        assert_eq!(guard.request(), CloseDecision::Prevent { notify: false });
+        // A failed frontend flush does not acknowledge the pending request.
+        assert_eq!(guard.request(), CloseDecision::Prevent { notify: false });
+        guard.confirm().unwrap();
+        assert_eq!(guard.request(), CloseDecision::Allow);
+        assert!(guard.confirm().is_err());
+    }
+
+    #[test]
+    fn enabling_again_does_not_revoke_an_approved_exit() {
+        let guard = CloseGuard::default();
+        guard.enable();
+        guard.request();
+        guard.confirm().unwrap();
+        guard.enable();
+        assert_eq!(guard.request(), CloseDecision::Allow);
+    }
+}
