@@ -0,0 +1,36 @@
+{
+  "$schema": "https://schema.tauri.app/config/2",
+  "identifier": "cloud.carldai.simlab.opcua.master",
+  "bundle": {
+    "createUpdaterArtifacts": false,
+    "icon": [
+      "suite-icons/32x32.png",
+      "suite-icons/128x128.png",
+      "suite-icons/128x128@2x.png",
+      "suite-icons/icon.icns",
+      "suite-icons/icon.ico"
+    ]
+  },
+  "plugins": {
+    "updater": null
+  },
+  "build": {
+    "beforeBuildCommand": {
+      "script": "npm run build",
+      "cwd": "../../master-frontend"
+    }
+  },
+  "app": {
+    "windows": [
+      {
+        "title": "OPC UA Master \u2014 SAIO",
+        "width": 1200,
+        "height": 800,
+        "minWidth": 800,
+        "minHeight": 600,
+        "resizable": true,
+        "fullscreen": false
+      }
+    ]
+  }
+}
