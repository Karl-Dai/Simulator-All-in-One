+
+const emit = defineEmits<{
+  close: []
+  retry: []
+}>()
+</script>
+
+<template>
+  <section class="error-notice" :aria-busy="busy">
+    <p class="error-notice__message" role="status" aria-live="polite" aria-atomic="true">{{ message }}</p>
