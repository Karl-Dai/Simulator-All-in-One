--- a/crates/opcuasim-core/src/client.rs
+++ b/crates/opcuasim-core/src/client.rs
@@ -179,7 +179,7 @@ impl OpcUaConnection {
         info!("Connecting to OPC UA server: {}", self.config.endpoint_url);
 
         // Build client
