{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "cloud.carldai.simlab.pmu.master",
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "suite-icons/32x32.png",
      "suite-icons/128x128.png",
      "suite-icons/128x128@2x.png",
      "suite-icons/icon.icns",
      "suite-icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": null
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "simlab-suite",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "store:default",
            "dialog:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "title": "PMU Master \u2014 SAIO",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
