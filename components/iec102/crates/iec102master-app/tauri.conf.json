{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IEC102Master",
  "version": "0.1.0",
  "identifier": "com.iec102master.dev",
  "build": {
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../master-frontend"
    },
    "frontendDist": "../../master-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IEC102 Master",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
