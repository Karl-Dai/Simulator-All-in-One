{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IEC102Slave",
  "version": "0.1.0",
  "identifier": "com.iec102slave.dev",
  "build": {
    "devUrl": "http://localhost:5184",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../frontend" },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IEC102 Slave",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
